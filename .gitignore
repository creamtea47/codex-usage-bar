# Tauri / React frontend build outputs
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*

# Rust and Tauri generated files. Cargo.lock is intentionally tracked for repeatable builds.
src-tauri/target/
src-tauri/gen/
# 发布签名验证器是独立 Cargo 工具；其本地 target 目录同样不应进入仓库。
scripts/verify-updater-signature/target/

# Keep the source SVG plus the two desktop bundle icons. Other generated mobile icons stay local.
src-tauri/icons/*
!src-tauri/icons/icon.svg
!src-tauri/icons/icon.ico
!src-tauri/icons/icon.icns
!src-tauri/icons/icon.png

# Local packages, screenshots, and legacy native build outputs
artifacts/
build/
build-vs/
docs/images/_*.png
*.obj
*.exe
*.pdb
*.ilk
widget-*.png
